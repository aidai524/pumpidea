#!/bin/sh
# WAL 看门狗 —— 每 15 分钟记一行 WAL 大小与 checkpoint 结果。
#
# 存在的理由：2026-10-15 与 10-16 两次 WAL 失控（33.5G / 35.5G）把磁盘打满，
# 采集器静默死掉数小时。这个脚本既是护栏（超阈值告警），也是证据
# （真复发时，日志会记录哪个时刻 checkpoint 被挡住、busy 是多少）。
set -u

DB=${WALWATCH_DB:-@APP@/runtime/stream.sqlite3}
LOG=/var/log/pumpfun-walwatch.log
WARN_MB=${WALWATCH_WARN_MB:-2048}       # WAL 超过 2G 告警
FREE_WARN_MB=${WALWATCH_FREE_MB:-10240}  # 所在卷可用低于 10G 告警

[ -f "$DB" ] || { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) DB 缺失: $DB"; exit 0; }

# 日志自身限体积（1 行/15min ≈ 96 行/天）
[ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 1048576 ] && : > "$LOG"

wal_mb=$(( $(stat -c %s "$DB-wal" 2>/dev/null || echo 0) / 1048576 ))

# 注意：用 df -P（单行输出）。df -m 在设备名过长时会折行，
# 用 NR==2 会抓到设备名那行、$4 为空 —— 这是个已踩过的坑。
free_mb=$(df -P "$DB" 2>/dev/null | awk 'NR==2{print int($4/1024)}')
[ -n "${free_mb:-}" ] || free_mb=0

# 用 .timeout 点命令而不是 PRAGMA busy_timeout —— 后者会打印 5000，
# 与 checkpoint 的结果粘在一起，把 busy 读数污染成 "50000|..."。
res=$(sqlite3 "$DB" ".timeout 5000" "PRAGMA wal_checkpoint(PASSIVE);" 2>&1 | tr -d '\n')
trunc="-"
if [ "$wal_mb" -gt "$WARN_MB" ]; then
  trunc=$(sqlite3 "$DB" ".timeout 5000" "PRAGMA wal_checkpoint(TRUNCATE);" 2>&1 | tr -d '\n')
fi

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
line="$ts wal=${wal_mb}MB free=${free_mb}MB passive=[$res] truncate=[$trunc]"
echo "$line" >> "$LOG"

if [ "$wal_mb" -gt "$WARN_MB" ] || [ "$free_mb" -lt "$FREE_WARN_MB" ]; then
  echo "WARN $line" >> "$LOG"
fi
